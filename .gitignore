/qiskit/
/.venv/

# === Files a solver run writes into its working directory (knapsack.c) ===
/groverStats.txt
/printCircuitFile.txt
/circuitText.txt
/circuitSchematic.tex
/circuitFigure*.qasm
/solverCircuit.qasm
/solverCircuit.meta
/aer_results.json
/qpu_results.json

# === Local recovery bundles / working artifacts (regenerable) ===
/archives/
/snapshots/
/ARCHIVE/
/ClaudeCodeConversation/
/draw_render/
/draw_xcheck/
/qasm_xcheck/

# === Editor / IDE ===
/.idea/

